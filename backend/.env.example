# Environment Variables
# Copy this file to .env and fill in real values. Never commit .env to git.

# Port the Express server listens on
PORT=8080

# Path to your Firebase service account key JSON file.
# Download from: Firebase Console → ⚙ Project Settings → Service Accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# (Optional) Your Firebase project ID — must match the one in serviceAccountKey.json
FIREBASE_PROJECT_ID=your-project-id

# (Optional) Allowed origins for CORS — comma separated
# Example: http://localhost:3000,https://yourapp.com
CORS_ORIGIN=*
